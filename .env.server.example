# ==============================================================================
# CareerFlow — Server & Orchestration Environment Template
# ==============================================================================
# Copy to `.env.server` (never commit `.env.server` to version control).
# STRICT INVARIANT (CFG-0016): Never expose server secrets to client/web bundles.

# ------------------------------------------------------------------------------
# 1. Runtime Environment & Governance (CF-ARCH-FREEZE-V1.0 / P00 Section 01)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
CAREERFLOW_ENV=DEVELOPMENT
CAREERFLOW_USER_ID=USR-0001
ENABLE_HITL_GATES=true
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Multi-Provider AI Gateway & Capability Routing (ADR-0001 / P00 Section 02)
# ------------------------------------------------------------------------------
# Supported providers: gemini | anthropic | openai
AI_DEFAULT_PROVIDER=gemini
AI_FALLBACK_PROVIDER=anthropic
AI_ENABLE_FALLBACK=true

# Per-Capability Provider Overrides (optional; overrides AI_DEFAULT_PROVIDER)
# Capabilities: structured-extraction | epistemic-audit | synthesis-drafting | classification
AI_PROVIDER_STRUCTURED_EXTRACTION=gemini
AI_PROVIDER_EPISTEMIC_AUDIT=anthropic
AI_PROVIDER_SYNTHESIS_DRAFTING=openai
AI_PROVIDER_CLASSIFICATION=gemini

# Provider API Keys (Configure keys only for enabled providers)
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Default Model Identifiers per Provider (Version-pinned)
GEMINI_DEFAULT_MODEL=gemini-2.5-pro
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
OPENAI_DEFAULT_MODEL=gpt-4.1

# ------------------------------------------------------------------------------
# 3. Primary Storage & Persistence Backends (V1 Sheets/Drive -> V2 Supabase)
# ------------------------------------------------------------------------------
# Storage mode: google-workspace | supabase | dual-write
STORAGE_MODE=google-workspace

# Supabase Server Credentials (Elevated privileges, bypasses RLS — SERVER ONLY)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Google Workspace V1 Operational Store Identifiers (P00 Section 03)
GOOGLE_OPERATIONAL_SHEET_ID=your-careerflow-operational-sheet-id
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-careerflow-drive-root-folder-id

# ------------------------------------------------------------------------------
# 4. n8n Orchestrator Webhook Integration (Internal / Authenticated Bridge)
# ------------------------------------------------------------------------------
N8N_BASE_URL=http://127.0.0.1:5678
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
N8N_SHARED_SECRET_TOKEN=your-n8n-internal-token-here