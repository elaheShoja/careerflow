# Supabase Service Role Key (Elevated privileges, bypasses RLS)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# n8n Orchestrator Webhook Integration (Internal network / authenticated bridge)
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
N8N_SHARED_SECRET_TOKEN=your-n8n-internal-token-here

# AI & LLM Execution Providers
GEMINI_API_KEY=your-gemini-api-key-here

# System Context
ENVIRONMENT=development
