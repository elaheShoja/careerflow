# ==============================================================================
# CareerFlow — Client Application Environment Template (apps/web)
# ==============================================================================
# Copy to `.env` for local development.
# SECURITY INVARIANT (CFG-0016): Never expose server secrets or AI API keys in
# VITE_* variables. All AI calls must route through server/orchestration layers.

# Environment Mode: DEVELOPMENT | TEST | PRODUCTION (CFG-0003)
VITE_APP_ENV=DEVELOPMENT

# Supabase Public Client Credentials (Safe for browser exposure with RLS)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Orchestration / API Gateway Base URL (n8n webhooks or backend edge gateway)
VITE_ORCHESTRATION_BASE_URL=http://localhost:5678/webhook